  EMAIL
  SLACK
}

enum CustomerSuccessOutreachStatus {
  DRAFT
  QUEUED
  SENT
  FAILED
  CANCELED
}

model DealCompany {
  id       String  @id @default(cuid())
  name     String
  domain   String?
  industry String?
  notes    String? @db.Text

  hubspotCompanyId String? @unique

  contacts       DealContact[]
  deals          Deal[]
  meetings       DealMeeting[]
  customerRecord CustomerRecord?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
}

model DealContact {
  id        String  @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  notes     String? @db.Text

  companyId String?
  company   DealCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  hubspotContactId String? @unique

  deals    Deal[]        @relation("DealContacts")
  meetings DealMeeting[] @relation("MeetingAttendees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([email])
}

model Deal {
  id     String     @id @default(cuid())
  name   String
  stage  DealStage  @default(LEAD)
  amount Float      @default(0)
  source DealSource @default(OTHER)

  expectedCloseDate DateTime?
  closedAt          DateTime?
  notes             String?   @db.Text

  companyId String?
  company   DealCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  ownerId String?
  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  hubspotDealId String? @unique

  contacts                  DealContact[]      @relation("DealContacts")
  meetings                  DealMeeting[]
  stageHistory              DealStageHistory[]
  primaryForCustomerRecords CustomerRecord[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([ownerId])
  @@index([companyId])
  @@index([source])
  @@index([closedAt])
  @@index([organizationId])
}

model DealStageHistory {
  id        String     @id @default(cuid())
  dealId    String
  deal      Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  fromStage DealStage?
  toStage   DealStage
  changedAt DateTime   @default(now())
  changedBy String?

  @@index([dealId, changedAt])
}

model DealMeeting {
  id     String        @id @default(cuid())
  title  String
  status MeetingStatus @default(SCHEDULED)

  startAt                   DateTime
  endAt                     DateTime?
  location                  String?
  notes                     String?             @db.Text
  googleDriveFileId         String?
  googleDriveFileName       String?
  googleDriveFileUrl        String?
  transcriptMatchedAt       DateTime?
  transcriptMatchConfidence Float?
  analysisArtifactId        String?             @unique
  analysisArtifact          AutomationArtifact? @relation("DealMeetingAnalysisArtifact", fields: [analysisArtifactId], references: [id], onDelete: SetNull)
  demoQualityScore          Int?
  demoQualitySummary        String?             @db.Text
  demoStrengthsJson         Json?
  demoGapsJson              Json?
  analyzedAt                DateTime?

  expectedAttendees Int @default(0)
  actualAttendees   Int @default(0)

  dealId String?
  deal   Deal?   @relation(fields: [dealId], references: [id], onDelete: SetNull)

  companyId String?
  company   DealCompany? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  customerRecordId String?
  customerRecord   CustomerRecord? @relation(fields: [customerRecordId], references: [id], onDelete: SetNull)

  hubspotMeetingId String? @unique

  attendees DealContact[] @relation("MeetingAttendees")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([dealId])
  @@index([companyId])
  @@index([customerRecordId])
  @@index([startAt])
  @@index([status])
  @@index([googleDriveFileId])
  @@index([analyzedAt])
}

model CustomerRecord {
  id             String                 @id @default(cuid())
  name           String
  segment        String?
  tier           String?
  lifecycleStage CustomerLifecycleStage @default(ONBOARDING)
  status         CustomerRecordStatus   @default(ACTIVE)
  metadata       Json?

  ownerId String?
  owner   User?   @relation("CustomerRecordOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  dealCompanyId String?      @unique
  dealCompany   DealCompany? @relation(fields: [dealCompanyId], references: [id], onDelete: SetNull)

  primaryDealId String?
  primaryDeal   Deal?   @relation(fields: [primaryDealId], references: [id], onDelete: SetNull)

  mergedIntoId String?
  mergedInto   CustomerRecord?  @relation("CustomerRecordMerge", fields: [mergedIntoId], references: [id], onDelete: SetNull)
  mergedFrom   CustomerRecord[] @relation("CustomerRecordMerge")

  externalRefs           CustomerRecordExternalRef[]
  notes                  CustomerSuccessNote[]
  plans                  CustomerSuccessPlan[]
  alerts                 CustomerSuccessAlertRecord[]
  outreachMessages       CustomerSuccessOutreachMessage[]
  meetings               DealMeeting[]
  retentionSourceRecords RetentionSourceRecord[]
  retentionTenantMonths  RetentionTenantMonth[]
  retentionTenantCurrent RetentionTenantCurrent?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([ownerId])
  @@index([mergedIntoId])
  @@index([status, lifecycleStage])
}

enum RetentionSourceKind {
  ARDA
  CODA
  STRIPE
  HUBSPOT
  PYLON
}

enum RetentionSyncRunStatus {
  SUCCESS
  PARTIAL
  ERROR
}

enum RetentionLifecyclePhase {
  ONBOARDING
  MATURE
}

enum RetentionTenantStatus {
  HEALTHY
  WATCH
  AT_RISK
  ONBOARDING_RISK
  BILLING_RISK
}

model RetentionSyncRun {
  id          String                 @id @default(cuid())
  source      RetentionSourceKind
  status      RetentionSyncRunStatus @default(SUCCESS)
  startedAt   DateTime               @default(now())
  completedAt DateTime?
  windowStart DateTime?
  windowEnd   DateTime?
  recordCount Int                    @default(0)
  mappedCount Int                    @default(0)
  errorCount  Int                    @default(0)
  notes       Json?
  lastError   String?                @db.Text

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  sourceRecords RetentionSourceRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([source, startedAt])
  @@index([organizationId, source, startedAt])
}

model RetentionSourceRecord {
  id              String              @id @default(cuid())
  syncRunId       String
  syncRun         RetentionSyncRun    @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  source          RetentionSourceKind
  objectType      String
  externalId      String
  tenantKey       String?
  occurredAt      DateTime?
  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?
  payload         Json

  customerRecordId String?
  customerRecord   CustomerRecord? @relation(fields: [customerRecordId], references: [id], onDelete: SetNull)

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([source, objectType, externalId])
  @@index([syncRunId])
  @@index([source, objectType, occurredAt])
  @@index([customerRecordId, occurredAt])
  @@index([organizationId, source, objectType])
}

model RetentionTenantMonth {
  id                  String                  @id @default(cuid())
  customerRecordId    String
  customerRecord      CustomerRecord          @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)
  monthStart          DateTime
  monthEnd            DateTime
  lifecyclePhase      RetentionLifecyclePhase
  status              RetentionTenantStatus?
  featureVersion      String                  @default("v1")
  primaryLirPassed    Boolean                 @default(false)
  primaryLirLabel     String?
  primaryLirValue     Float?
  primaryLirThreshold Float?
  primaryLirScore     Float?
  reasonCodes         Json?
  featureData         Json
  outcomeData         Json
  coverageData        Json?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  currentSnapshot RetentionTenantCurrent?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerRecordId, monthStart, featureVersion])
  @@index([organizationId, monthStart])
  @@index([status, monthStart])
  @@index([customerRecordId, monthStart(sort: Desc)])
}

model RetentionTenantCurrent {
  id                   String                  @id @default(cuid())
  customerRecordId     String                  @unique
  customerRecord       CustomerRecord          @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)
  monthFactId          String                  @unique
  monthFact            RetentionTenantMonth    @relation(fields: [monthFactId], references: [id], onDelete: Cascade)
  lifecyclePhase       RetentionLifecyclePhase
  status               RetentionTenantStatus
  primaryLirPassed     Boolean                 @default(false)
  primaryLirLabel      String
  primaryLirValue      Float?
  primaryLirThreshold  Float?
  currentMonthActivity Float?
  activityTrendPct     Float?
  supportRisk          Boolean                 @default(false)
  billingRisk          Boolean                 @default(false)
  onboardingRisk       Boolean                 @default(false)
  icp                  Boolean                 @default(false)
  ownerName            String?
  segment              String?
  plan                 String?
  ageBucket            String?
  summaryData          Json
  detailData           Json
  reasonCodes          Json
  lastMaterializedAt   DateTime                @default(now())

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([organizationId, lifecyclePhase])
  @@index([organizationId, icp])
}

model CustomerRecordExternalRef {
  id                 String                   @id @default(cuid())
  customerRecordId   String
  customerRecord     CustomerRecord           @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)
  provider           CustomerExternalProvider
  externalObjectType String                   @default("account")
  externalId         String
  label              String?
  isPrimary          Boolean                  @default(false)
  metadata           Json?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerRecordId, provider, externalObjectType, externalId])
  @@index([organizationId])
  @@index([provider, externalId])
}

model CustomerSuccessNote {
  id               String                        @id @default(cuid())
  customerRecordId String
  customerRecord   CustomerRecord                @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)
  authorUserId     String?
  authorUser       User?                         @relation("CustomerSuccessNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  title            String?
  body             String
  source           CustomerSuccessNoteSource     @default(MANUAL)
  visibility       CustomerSuccessNoteVisibility @default(INTERNAL)
  metadata         Json?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerRecordId, createdAt])
  @@index([organizationId])
  @@index([authorUserId])
}

model CustomerSuccessPlan {
  id               String                         @id @default(cuid())
  customerRecordId String
  customerRecord   CustomerRecord                 @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)
  name             String
  templateKey      String?
  status           CustomerSuccessPlanStatus      @default(DRAFT)
  ownerUserId      String?
  ownerUser        User?                          @relation("CustomerSuccessPlanOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  startedAt        DateTime?
  targetDate       DateTime?
  completedAt      DateTime?
  metadata         Json?
  milestones       CustomerSuccessPlanMilestone[]

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerRecordId, status])
  @@index([organizationId])
  @@index([ownerUserId])
}

model CustomerSuccessPlanMilestone {
  id          String                         @id @default(cuid())
  planId      String
  plan        CustomerSuccessPlan            @relation(fields: [planId], references: [id], onDelete: Cascade)
  title       String
  description String?
  status      CustomerSuccessMilestoneStatus @default(NOT_STARTED)
  dueDate     DateTime?
  completedAt DateTime?
  sortOrder   Int                            @default(0)
  metadata    Json?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId, sortOrder])
  @@index([organizationId])
}

model CustomerSuccessAlertRecord {
  id               String                       @id @default(cuid())
  customerRecordId String
  customerRecord   CustomerRecord               @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)
  alertKey         String
  title            String
  category         CustomerSuccessAlertCategory
  severity         CustomerSuccessAlertSeverity @default(MEDIUM)
  status           CustomerSuccessAlertStatus   @default(OPEN)
  slaStatus        CustomerSuccessSlaStatus     @default(NONE)
  source           CustomerSuccessAlertSource
  evidence         Json?
  suggestedAction  String?
  ownerUserId      String?
  ownerUser        User?                        @relation("CustomerSuccessAlertOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  openedAt         DateTime                     @default(now())
  resolvedAt       DateTime?
  lastEvaluatedAt  DateTime?
  metadata         Json?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([customerRecordId, alertKey])
  @@index([organizationId, status, severity])
  @@index([ownerUserId])
}

model CustomerSuccessOutreachMessage {
  id                String                         @id @default(cuid())
  customerRecordId  String
  customerRecord    CustomerRecord                 @relation(fields: [customerRecordId], references: [id], onDelete: Cascade)
  authorUserId      String?
  authorUser        User?                          @relation("CustomerSuccessOutreachAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  channel           CustomerSuccessOutreachChannel
  status            CustomerSuccessOutreachStatus  @default(DRAFT)
  templateKey       String?
  recipientName     String?
  recipientAddress  String
  subject           String?
  body              String
  providerMessageId String?
  providerThreadId  String?
  queuedAt          DateTime?
  sentAt            DateTime?
  failedAt          DateTime?
  error             String?
  metadata          Json?

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([customerRecordId, status, createdAt])
  @@index([organizationId])
  @@index([authorUserId])
  @@index([providerMessageId])
}

// ── Financial Planning ──

enum BudgetPeriod {
  MONTHLY
  QUARTERLY
  ANNUAL
}

enum ExpenseCategory {
  PAYROLL
  MARKETING
  INFRASTRUCTURE
  OPS
  COGS
  OTHER
}

enum GoalMetric {
  MRR
  ARR
  RUNWAY
  BURN_RATE
  NET_CASH_FLOW
  REVENUE
  CUSTOMER_COUNT
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  MISSED
}

model Budget {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  period    BudgetPeriod
  startDate DateTime
  endDate   DateTime
  lineItems BudgetLineItem[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
}

model BudgetLineItem {
  id            String          @id @default(cuid())
  budgetId      String
  budget        Budget          @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  category      ExpenseCategory
  plannedAmount Float
  notes         String?

  @@index([budgetId])
}

model FinancialGoal {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric      GoalMetric
  targetValue Float
  deadline    DateTime
  status      GoalStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())

  @@index([userId, status])
}

model ForecastScenario {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  assumptions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
}

// ============================================================
// FUNNEL ANALYTICS
// ============================================================

model SubmissionEvent {
  id          String   @id @default(cuid())
  type        String // e.g. "download_request", "form_submission"
  referenceId String? // optional external reference
  metadata    Json     @default("{}")
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([type, createdAt])
}

enum FunnelEventType {
  PAGE_VIEW
  SESSION_STARTED
  AUTH_COMPLETED
  DEMO_BOOKED
  KANBAN_CARD_CREATED
  TRIAL_STARTED
  PAID_CUSTOMER
}

enum FunnelIdentityType {
  EMAIL
  USER_ID
  HUBSPOT_CONTACT_ID
  HUBSPOT_DEAL_ID
  STRIPE_CUSTOMER_ID
  CODA_EMAIL
}

enum FunnelLinkProvenance {
  EXACT
  INFERRED
  BACKFILLED
}

enum EnrichmentProvider {
  UNIFY
  CLAY
  RB2B
}

model FunnelVisitor {
  id                    String                   @id @default(cuid())
  anonymousId           String                   @unique
  siteHost              String?
  firstTouchSource      String?
  firstTouchChannel     String?
  firstTouchCampaign    String?
  firstTouchReferrer    String?
  firstTouchLandingPath String?
  firstTouchLandingUrl  String?
  lastTouchSource       String?
  lastTouchChannel      String?
  lastTouchCampaign     String?
  lastTouchReferrer     String?
  lastTouchPath         String?
  lastTouchUrl          String?
  firstSeenAt           DateTime
  lastSeenAt            DateTime
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  events                FunnelEvent[]
  identityLinks         FunnelIdentityLink[]
  enrichmentSignals     FunnelEnrichmentSignal[]

  @@index([firstSeenAt])
  @@index([lastSeenAt])
  @@index([firstTouchChannel, firstSeenAt])
  @@index([firstTouchSource, firstSeenAt])
  @@index([firstTouchCampaign, firstSeenAt])
  @@index([siteHost, firstSeenAt])
}

model FunnelEvent {
  id         String          @id @default(cuid())
  visitorId  String
  visitor    FunnelVisitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  eventType  FunnelEventType
  occurredAt DateTime
  source     String?
  channel    String?
  campaign   String?
  path       String?
  url        String?
  referrer   String?
  dedupeKey  String?         @unique
  metadata   Json            @default("{}")
  createdAt  DateTime        @default(now())

  @@index([visitorId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([channel, occurredAt])
}

model FunnelIdentityLink {
  id            String               @id @default(cuid())
  visitorId     String
  visitor       FunnelVisitor        @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  identityType  FunnelIdentityType
  identityValue String
  provider      String
  provenance    FunnelLinkProvenance @default(EXACT)
  confidence    Float                @default(1)
  metadata      Json?
  userId        String?
  user          User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@unique([visitorId, identityType, identityValue])
  @@index([identityType, identityValue])
  @@index([userId])
  @@index([provider, provenance])
}

model FunnelEnrichmentSignal {
  id          String             @id @default(cuid())
  provider    EnrichmentProvider
  signalKey   String
  visitorId   String?
  visitor     FunnelVisitor?     @relation(fields: [visitorId], references: [id], onDelete: SetNull)
  anonymousId String?
  email       String?
  domain      String?
  fullName    String?
  companyName String?
  confidence  Float              @default(0)
  occurredAt  DateTime?
  accepted    Boolean            @default(false)
  metadata    Json               @default("{}")
  payload     Json
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@unique([provider, signalKey])
  @@index([visitorId])
  @@index([email])
  @@index([domain])
  @@index([accepted, createdAt])
}

// ============================================================
// INSIGHT PREFERENCES
// ============================================================

model InsightPreference {
  id        String   @id @default(cuid())
  userId    String
  insightId String   @db.VarChar(256)
  status    String   @db.VarChar(20) // "pinned" | "dismissed"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, insightId], name: "userId_insightId")
  @@index([userId])
  @@map("insight_preferences")
}

// ============================================================
// IMLADRIS RAW + CANONICAL DATA LAYER
// ============================================================

enum ImladrisSyncStatus {
  SUCCESS
  PARTIAL
  ERROR
}

enum ImladrisMetricStatus {
  READY
  PARTIAL
  STALE
  MISSING
  ERROR
}

model ImladrisSourceSyncRun {
  id             String                    @id @default(cuid())
  provider       IntegrationProvider
  status         ImladrisSyncStatus        @default(SUCCESS)
  mode           String                    @default("incremental")
  windowStart    DateTime?
  windowEnd      DateTime?
  startedAt      DateTime                  @default(now())
  completedAt    DateTime?
  recordCount    Int                       @default(0)
  acceptedCount  Int                       @default(0)
  errorCount     Int                       @default(0)
  checkpoint     Json?
  lastError      String?                   @db.Text
  userId         String?
  organizationId String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  rawRecords     ImladrisRawSourceRecord[]

  @@index([provider, startedAt])
  @@index([organizationId, provider, startedAt])
  @@index([userId, provider, startedAt])
}

model ImladrisRawSourceRecord {
  id              String                  @id @default(cuid())
  syncRunId       String
  syncRun         ImladrisSourceSyncRun   @relation(fields: [syncRunId], references: [id], onDelete: Cascade)
  provider        IntegrationProvider
  objectType      String
  externalId      String
  scopeKey        String
  sourceCreatedAt DateTime?
  sourceUpdatedAt DateTime?
  occurredAt      DateTime?
  payload         Json
  payloadHash     String
  userId          String?
  organizationId  String?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  metricLineage   ImladrisMetricLineage[]

  @@unique([provider, objectType, externalId, scopeKey])
  @@index([syncRunId])
  @@index([provider, objectType, occurredAt])
  @@index([scopeKey, provider, objectType])
  @@index([organizationId, provider, objectType])
}

model ImladrisCanonicalMetricValue {
  id                 String                  @id @default(cuid())
  metricKey          String
  department         String
  unit               String
  value              Json
  periodStart        DateTime
  periodEnd          DateTime
  status             ImladrisMetricStatus    @default(MISSING)
  confidence         Float                   @default(0)
  warnings           String[]                @default([])
  calculationVersion String
  computedAt         DateTime                @default(now())
  userId             String?
  organizationId     String?
  lineage            ImladrisMetricLineage[]

  @@unique([organizationId, userId, metricKey, periodEnd, calculationVersion])
  @@index([metricKey, periodEnd(sort: Desc)])
  @@index([organizationId, department, periodEnd(sort: Desc)])
  @@index([userId, department, periodEnd(sort: Desc)])
  @@index([status])
}

model ImladrisMetricLineage {
  id            String                       @id @default(cuid())
  metricValueId String
  metricValue   ImladrisCanonicalMetricValue @relation(fields: [metricValueId], references: [id], onDelete: Cascade)
  rawRecordId   String?
  rawRecord     ImladrisRawSourceRecord?     @relation(fields: [rawRecordId], references: [id], onDelete: SetNull)
  sourceKey     String
  sourceType    String
  sourceId      String?
  capturedAt    DateTime?
  metadata      Json?
  createdAt     DateTime                     @default(now())

  @@index([metricValueId])
  @@index([rawRecordId])
  @@index([sourceKey, capturedAt])
}
