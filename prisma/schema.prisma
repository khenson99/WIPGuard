  CLOSED_LOST
}

enum DealSource {
  ADS
  WEBSITE
  ORGANIC
  REFERRAL
  CONFERENCE
  OUTBOUND
  PARTNER
  OTHER
}

enum MeetingStatus {
  SCHEDULED
  COMPLETED
  CANCELED
  NO_SHOW
}

enum CustomerLifecycleStage {
  ONBOARDING
  ADOPTION
  ACTIVE
  EXPANSION
  RENEWAL
  AT_RISK
  CHURNED
}

enum CustomerRecordStatus {
  ACTIVE
  ARCHIVED
  MERGED
}

enum CustomerExternalProvider {
  INTERNAL
  HUBSPOT
  STRIPE
  PYLON
  CODA
  SLACK
  GOOGLE_WORKSPACE
}

enum CustomerSuccessNoteSource {
  MANUAL
