# The Mother Node Environment Variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For secrets, generate a random value with:
#   openssl rand -base64 32

# ──────────────────────────────────────────────
# REQUIRED — the app will not start without these
# ──────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/the_mother_node
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# RECOMMENDED — needed for token encryption and invite links
# ──────────────────────────────────────────────

INTEGRATION_TOKEN_SECRET=
INVITE_TOKEN_SECRET=

# ──────────────────────────────────────────────
# OPTIONAL — enable third-party integrations
# ──────────────────────────────────────────────

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Meta
META_CLIENT_ID=
META_CLIENT_SECRET=

# Visitor Funnel Enrichment
VISITOR_FUNNEL_ENRICH_SECRET=
CLAY_FUNNEL_ENRICH_SECRET=
RB2B_FUNNEL_ENRICH_SECRET=
UNIFY_FUNNEL_ENRICH_SECRET=
UNIFY_DATA_API_KEY=
UNIFY_FUNNEL_OBJECT_NAME=website_visitors
UNIFY_FUNNEL_SYNC_ENABLED=true
UNIFY_FUNNEL_INITIAL_LOOKBACK_HOURS=168
UNIFY_FUNNEL_CURSOR_OVERLAP_MINUTES=60
UNIFY_FUNNEL_MAX_RECORDS=500
