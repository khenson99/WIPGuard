# The Mother Node Environment Variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For secrets, generate a random value with:
#   openssl rand -base64 32

# ──────────────────────────────────────────────
# REQUIRED — the app will not start without these
# ──────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/the_mother_node
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# RECOMMENDED — needed for token encryption and invite links
# ──────────────────────────────────────────────

INTEGRATION_TOKEN_SECRET=
INVITE_TOKEN_SECRET=

# ──────────────────────────────────────────────
# OPTIONAL — enable third-party integrations
# ──────────────────────────────────────────────

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_SCOPES=crm.objects.deals.read crm.objects.deals.write crm.objects.contacts.read

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Stripe
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
STRIPE_SCOPES=read_write
# Optional fallback for server-managed analytics ingestion
STRIPE_SECRET_KEY=

# Meta
META_APP_ID=
META_APP_SECRET=
# Legacy aliases still accepted: META_CLIENT_ID / META_CLIENT_SECRET

# Visitor Funnel Enrichment
VISITOR_FUNNEL_ENRICH_SECRET=
CLAY_FUNNEL_ENRICH_SECRET=
RB2B_FUNNEL_ENRICH_SECRET=
UNIFY_FUNNEL_ENRICH_SECRET=
UNIFY_DATA_API_KEY=
# Legacy alias still accepted: UNIFY_API_KEY
UNIFY_FUNNEL_OBJECT_NAME=website_visitors
UNIFY_FUNNEL_SYNC_ENABLED=true
UNIFY_FUNNEL_INITIAL_LOOKBACK_HOURS=168
UNIFY_FUNNEL_CURSOR_OVERLAP_MINUTES=60
UNIFY_FUNNEL_MAX_RECORDS=500
VISITOR_FUNNEL_ALERTS_ENABLED=false
VISITOR_FUNNEL_ALERT_SLACK_CHANNEL_ID=
VISITOR_FUNNEL_ALERT_MIN_INTERVAL_HOURS=24

# OpenAI automation runtime
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_AUTOMATION_MODEL=gpt-4.1-mini

# Automation ingress and GitHub execution
AUTOMATION_INGEST_TOKEN=
GITHUB_TOKEN=
# Legacy alias still accepted: GITHUB_ACCESS_TOKEN
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_PROJECT_V2_ID=

# Product and development analytics
POSTHOG_API_KEY=
# Legacy alias still accepted: POSTHOG_PERSONAL_API_KEY
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://app.posthog.com
LINEAR_API_KEY=
# Legacy alias still accepted: LINEAR_TOKEN

# Search and SEO data
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
# Legacy aliases still accepted: GSC_SITE_URL, GSC_ACCESS_TOKEN
SEMRUSH_API_TOKEN=
# Legacy alias still accepted: SEMRUSH_API_KEY

# Worker toggles
WORKER_SYNC_AUTOMATIONS=true
