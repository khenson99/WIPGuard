# WIPGuard Environment Variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For secrets, generate a random value with:
#   openssl rand -base64 32

# ──────────────────────────────────────────────
# REQUIRED — the app will not start without these
# ──────────────────────────────────────────────

DATABASE_URL=postgresql://user:password@localhost:5432/wipguard
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# RECOMMENDED — needed for token encryption and invite links
# ──────────────────────────────────────────────

INTEGRATION_TOKEN_SECRET=
INVITE_TOKEN_SECRET=

# ──────────────────────────────────────────────
# OPTIONAL — enable third-party integrations
# ──────────────────────────────────────────────

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Meta
META_CLIENT_ID=
META_CLIENT_SECRET=
