# The Mother Node Environment Variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env
#
# For secrets, generate a random value with:
#   openssl rand -base64 32

# ──────────────────────────────────────────────
# REQUIRED — the app will not start without these
# ──────────────────────────────────────────────

DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ──────────────────────────────────────────────
# RECOMMENDED — needed for token encryption and invite links
# ──────────────────────────────────────────────

INTEGRATION_TOKEN_SECRET=
INVITE_TOKEN_SECRET=

# ──────────────────────────────────────────────
# OPTIONAL — enable third-party integrations
# ──────────────────────────────────────────────

# HubSpot
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_SCOPES=crm.objects.deals.read crm.objects.deals.write crm.objects.contacts.read

# Slack
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Stripe
STRIPE_CLIENT_ID=
STRIPE_CLIENT_SECRET=
STRIPE_SCOPES=read_write
# Optional fallback for server-managed analytics ingestion
STRIPE_SECRET_KEY=

# Customer health retention sync
CODA_API_TOKEN=
CODA_RETENTION_DOC_ID=
CODA_MASTER_ORDER_ARCHIVE_TABLE_ID=
ARDA_TENANT_CONFIG_CODA_DOC_ID=
ARDA_TENANT_CONFIG_TABLE_ID=
ARDA_API_BASE_URL=
ARDA_API_TOKEN=
# Optional Arda API overrides
ARDA_API_AUTHOR=
ARDA_API_AUTH_HEADER=

# Meta
META_APP_ID=
META_APP_SECRET=
# Legacy aliases still accepted: META_CLIENT_ID / META_CLIENT_SECRET

# Visitor Funnel Enrichment
VISITOR_FUNNEL_ENRICH_SECRET=
CLAY_FUNNEL_ENRICH_SECRET=
RB2B_FUNNEL_ENRICH_SECRET=
UNIFY_FUNNEL_ENRICH_SECRET=
UNIFY_DATA_API_KEY=
# Legacy alias still accepted: UNIFY_API_KEY
UNIFY_FUNNEL_OBJECT_NAME=website_visitors
UNIFY_FUNNEL_SYNC_ENABLED=true
UNIFY_FUNNEL_INITIAL_LOOKBACK_HOURS=168
UNIFY_FUNNEL_CURSOR_OVERLAP_MINUTES=60
UNIFY_FUNNEL_MAX_RECORDS=500
VISITOR_FUNNEL_ALERTS_ENABLED=false
VISITOR_FUNNEL_ALERT_SLACK_CHANNEL_ID=
VISITOR_FUNNEL_ALERT_MIN_INTERVAL_HOURS=24

# OpenAI automation runtime
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
OPENAI_AUTOMATION_MODEL=gpt-4.1-mini

# Automation ingress and GitHub execution
AUTOMATION_INGEST_TOKEN=
GITHUB_TOKEN=
# Legacy alias still accepted: GITHUB_ACCESS_TOKEN
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
GITHUB_PROJECT_V2_ID=
# Owner user for scheduled integration syncs and external Imladris investor exports
INTEGRATION_OWNER_USER_ID=

# Product and development analytics
POSTHOG_API_KEY=
# Legacy alias still accepted: POSTHOG_PERSONAL_API_KEY
POSTHOG_PROJECT_ID=
POSTHOG_HOST=https://app.posthog.com
LINEAR_API_KEY=
# Legacy alias still accepted: LINEAR_TOKEN

# Search and SEO data
GOOGLE_SEARCH_CONSOLE_SITE_URL=
GOOGLE_SEARCH_CONSOLE_ACCESS_TOKEN=
# Legacy aliases still accepted: GSC_SITE_URL, GSC_ACCESS_TOKEN
SEMRUSH_API_TOKEN=
# Legacy alias still accepted: SEMRUSH_API_KEY

# Worker toggles
WORKER_SYNC_AUTOMATIONS=true

# Database growth controls (see docs/db-growth-controls.md). All optional —
# defaults shown. Enforced continuously during the sync cycle, mirroring
# ANALYTICS_SNAPSHOT_RETENTION_DAYS (default 30) for analytics snapshots.
# Lineage detail of superseded Imladris metric values is deleted after this
# many days; the latest reader-visible value per metric always keeps its
# lineage regardless of age.
IMLADRIS_LINEAGE_RETENTION_DAYS=14
# Per-source cap on lineage rows persisted per metric value.
IMLADRIS_LINEAGE_MAX_ROWS_PER_SOURCE=1000
# Soft time budget per sync cycle for lineage pruning (resumes next cycle).
IMLADRIS_LINEAGE_PRUNE_BUDGET_MS=60000
# Terminal outbox events: DISPATCHED deleted after N days; DEAD_LETTER kept
# longer so they stay inspectable/replayable. PENDING/FAILED are never pruned.
OUTBOX_DISPATCHED_RETENTION_DAYS=14
OUTBOX_DEAD_LETTER_RETENTION_DAYS=30
OUTBOX_PRUNE_BUDGET_MS=15000
