{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "next dev",
    "db:generate": "prisma generate --schema prisma/schema.prisma",
    "retention:sync": "npx tsx scripts/retention/sync-sources.ts",
    "retention:bootstrap-customers": "npx tsx scripts/retention/bootstrap-customers.ts",
    "retention:build-dataset": "npx tsx scripts/retention/build-dataset.ts",
    "retention:analyze": "npx tsx scripts/retention/run-analysis.ts",
    "retention:analyze-coda-lir": "npx tsx scripts/retention/analyze-coda-lir.ts",
    "retention:analyze-arda-coda-lir": "npx tsx scripts/retention/analyze-arda-coda-lir.ts",
    "retention:materialize": "npx tsx scripts/retention/materialize-current.ts",
    "retention:gaps": "npx tsx scripts/retention/export-gaps.ts",
    "retention:run": "npx tsx scripts/retention/run-all.ts",
    "imladris:materialize": "npx tsx worker/imladris-materialization-runner.ts",
    "ops:ads-preflight": "./scripts/ads-analytics-preflight.sh",
    "ops:backfill-google-oauth-scopes": "node ./scripts/backfill-google-oauth-scope-aliases.cjs",
    "prepare": "husky",
    "prebuild": "npm run db:generate",
    "precommit:quality": "lint-staged",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "pretest": "npm run db:generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:staged": "node ./scripts/typecheck-staged.mjs"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "chart.js": "^4.4.1",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "ioredis": "^5.10.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "next-auth": "^4.24.13",
    "next-themes": "^0.4.6",
    "openai": "^6.27.0",
    "p-throttle": "^8.1.0",
    "pg": "^8.18.0",
    "prisma": "^7.4.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "tsx": "^4.22.4",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.2",
    "tailwindcss": "^4",
    "tsc-files": "^1.1.4",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,tsx}": [
      "eslint --fix --max-warnings=0 --no-warn-ignored"
    ],
    "*.{ts,tsx}": [
      "npm run typecheck:staged --"
    ]
  }
}
